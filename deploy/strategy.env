# Strategy defaults merged only when a setting is absent from greeks.env.
# Runtime mode, automatic trading, credentials and state paths are never changed here.
STRATEGY_MODE=iron_condor
MAX_RISK_USD=2500
# Short strangle: regular Order IM estimate plus buffer, not a maximum loss limit.
MAX_MARGIN_USD=2500
LEG_QTY=1
OPEN_DAY=4
OPEN_HOUR_UTC=21
OPEN_MINUTE_UTC=0
OPEN_WINDOW_SECONDS=300
# Compatibility only: expiry remains the next listed Sunday.
TARGET_DTE_DAYS=2
RECV_WINDOW_MS=5000
MARKET_REFRESH_SECONDS=10
INSTRUMENT_REFRESH_SECONDS=3600
QUOTE_STALE_SECONDS=30
MAX_SPREAD_BPS=0
FAILED_LEG_RETRY_DELAY_SECONDS=0.8
FAILED_LEG_POSITION_CHECKS=5
FAILED_LEG_POSITION_CHECK_INTERVAL_SECONDS=1
ESTIMATED_TAKER_FEE_RATE=0.0003
PORTFOLIO_MARGIN_BUFFER_PCT=0.10
MARGIN_MODE=PORTFOLIO_MARGIN
OPTION_MM_FACTOR=0.03
OPTION_MAX_IM_FACTOR=0.10
OPTION_MIN_IM_FACTOR=0.05
OPTION_LIQUIDATION_FEE_RATE=0.002
OPTION_FEE_CAP_PCT=0.07
BBO_POLL_SECONDS=1
BBO_ORDER_TIMEOUT_SECONDS=280
# Compatibility name: use price-capped IOC orders for confirmed unfilled remainders.
ALLOW_MARKET_FALLBACK=true
ACCOUNT_CACHE_SECONDS=2
RECONCILIATION_SECONDS=15
PERFORMANCE_SAMPLE_SECONDS=60
# Compatibility field; this is not an automatic-trading confirmation switch.
LIVE_CONFIRMATION=
